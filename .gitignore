# Python
__pycache__/
*.py[oc]
build/
wheels/
*.egg-info
.venv/

# テストキャッシュ
.pytest_cache/

# ローカル設定・秘密情報（.env.example をコピーして使う）
.env
.env.*
!.env.example

# ローカルDB
*.db
*.db-journal

# パイプライン中間出力（実行のたびに生成される、ソースではない。
# ディレクトリ自体は .gitkeep で維持する）
backend/pipeline/*/output/*
backend/jobs/output/*
!backend/pipeline/*/output/.gitkeep
!backend/jobs/output/.gitkeep
backend/services/rag/cache/
backend/services/output/

# パイプラインの構造化タイミングログ(backend/jobs/timing.py)の出力先
backend/logs/*.log

# フロントエンドの依存パッケージ・ビルド成果物
node_modules/
frontend/dist/

# OS / エディタ / ツール固有
.DS_Store
.vscode/
Thumbs.db
desktop.ini
.idea/

# 一時ファイル・バックアップ・カバレッジ
*.tmp
*.bak
*.old
coverage/
htmlcov/
.coverage

# 提出用リポジトリには含めないドキュメント（ローカルには残す）
/docs/
/*.md
!/README.md
