LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Ollamaのcontext window（トークン数）。未設定時は8192。長い仕様書やタスク一覧の切り捨てを防ぐ
# OLLAMA_NUM_CTX=8192
# LLM呼び出しの最大同時実行数（未設定時は1＝逐次実行。上げる前に自環境で実測すること）
# OLLAMA_MAX_CONCURRENCY=1
MAX_TASKS_FREE=50

# 実験的RAG機能（既定はfalse。既存パイプラインの挙動は変わらない）
ENABLE_RAG=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ALLOWED_ORIGINS=http://localhost:5173

# LLM_PROVIDER=anthropic を使う場合
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
