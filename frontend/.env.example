# このファイルをコピーして .env.local （個人用、通常Git管理しない）を作り、
# 実際のバックエンドのアドレスに書き換えて使う。
#
#   cp .env.example .env.local
#
# フロントエンドとバックエンドを別のMac/PCで動かす場合（例: フロントを
# Mac B、バックエンドをMac Aで起動する場合）は、下記の2つの値を
# バックエンドが実際に動いているマシンのIPに書き換えること。
# 同じマシンで両方動かす場合は http://localhost:8000 のままでよい。

# バックエンドのベースURL。/api/tasks, /api/settings, /healthz など、
# Cookieセッションを必要としない既存(legacy)エンドポイントを直接叩く際に使う。
VITE_API_BASE_URL=http://localhost:8000

# Cookieセッションを必要とする全てのAPI
# （チーム/招待/セッション認証、プロジェクト・メンバー・生成ジョブ:
#  /api/teams*, /api/me, /api/sessions*, /api/projects*, /api/jobs*）の
# 実体。VITE_ を付けないため、クライアントバンドルには含まれず
# vite.config.ts（開発サーバーのプロキシ設定）からのみ参照される。
#
# 【重要】フロントとバックエンドが別ホストの場合、バックエンドが発行する
# セッションCookieは SameSite=Lax のため、ブラウザはクロスサイトの
# fetch/XHRにそのCookieを付与しない。そのため src/api/client.ts の
# apiClient/authApiClient は baseURL を相対パス（空文字）にし、常に
# このプロキシ（vite.config.tsが `/api` をここへ中継し、ブラウザから見て
# 同一オリジンに見せかける）経由でアクセスする設計になっている。
# ここが実際のバックエンドと食い違っていると、チーム作成・プロジェクト作成・
# メンバー登録・タスク生成ジョブの開始など、Cookieを使う機能だけが
# 静かに失敗するので注意（画面には「バックエンドに接続できませんでした」
# という汎用エラーだけが出る）。
BACKEND_PROXY_TARGET=http://localhost:8000

# フロントエンド単体デモ/開発モード。
# true にすると、GET /api/me が失敗した場合（＝バックエンド未接続）に限り、
# チーム作成画面の代わりにダッシュボードをサンプルデータで表示できる
# （src/auth/router.ts 参照）。本番の認証・認可ロジックは一切変更しない。
# 本番運用・実機テスト時は必ず false にすること。
VITE_DEMO_MODE=false
